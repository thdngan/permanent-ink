{
	"name": "permanent-ink",
	"version": "1.1.0",
	"description": "Turn every deletion into a visible strikethrough, and keep a history of thought process with color-coded highlights and an annotation sidebar.",
	"main": "./build/main.js",
	"scripts": {
		"dev": "conc \"npm run dev:css -- --watch\" \"node esbuild.config.mjs\"",
		"dev:css": "tailwindcss -i ./src/styles.css -o ./sandbox/.obsidian/plugins/plugin/styles.css",
		"build": "npm run ts:check && npm run lint -- --quiet && npm run build:css && node esbuild.config.mjs production",
		"build:css": "tailwindcss -i ./src/styles.css -o ./build/styles.css",
		"ts:check": "tsc -noEmit -skipLibCheck",
		"lint": "eslint ./src",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"annotations",
		"strikethrough",
		"highlight",
		"writing"
	],
	"author": "thdngan",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.14.0",
		"@types/node": "^22.8.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-resizable": "^3.0.8",
		"caniuse-lite": "1.0.30001810",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.0",
		"esbuild": "0.24.2",
		"eslint": "^9.14.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-tailwindcss": "^3.17.5",
		"globals": "^15.12.0",
		"obsidian": "latest",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.8",
		"tailwind-merge": "^2.5.4",
		"tailwindcss": "3.4.17",
		"tslib": "^2.8.1",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.13.0"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-draggable": "^4.5.0",
		"react-resizable": "^3.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thdngan/permanent-ink.git"
	},
	"bugs": {
		"url": "https://github.com/thdngan/permanent-ink/issues"
	},
	"homepage": "https://github.com/thdngan/permanent-ink#readme"
}
